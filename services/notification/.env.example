APP_NAME="XAUUSD Notification"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:18102

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xauusd_public
DB_USERNAME=tickbase_news_local
DB_PASSWORD=change-me-local-database-password
DB_SEARCH_PATH=notify,public
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

NOTIFICATION_INTERNAL_SECRET=change-me-local-notification-gateway
NOTIFICATION_ENABLED=false
NOTIFICATION_DRY_RUN=true
NOTIFICATION_SUPPORTED_LANGUAGES=zh-Hant,en
NOTIFICATION_DEFAULT_LANGUAGE=zh-Hant
NOTIFICATION_INITIAL_PAID_CAP=100
NOTIFICATION_ADMISSION_ENABLED=false
NOTIFICATION_CHANNEL_FINGERPRINT_KEY=
HORIZON_ALLOWED_IPS=127.0.0.1,::1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ACCOUNT_INTERNAL_URL=http://127.0.0.1:18100
NEWS_INTERNAL_SECRET=change-me-local-news-access
NEWS_PUBLIC_ORIGIN=http://localhost:18103
LOCAL_SERVER_PORT=18102
DIGEST_ENABLED=false
DIGEST_MODEL_PROVIDER=openrouter
DIGEST_MODEL_BASE_URL=https://openrouter.ai/api/v1
DIGEST_MODEL_API_KEY=
DIGEST_MODEL_NAME=
DIGEST_MODEL_TIMEOUT_SECONDS=60
DIGEST_MODEL_MAX_OUTPUT_TOKENS=1800

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
