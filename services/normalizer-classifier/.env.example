# disable paid fallback, use low reasoning and zh-Hant,en,th,ja output.
# Provider routing is price-sorted and limited to these USD/million-token caps.
TRANSLATION_MAX_PROMPT_PRICE=0.03
TRANSLATION_MAX_COMPLETION_PRICE=0.17
