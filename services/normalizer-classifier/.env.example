# Evaluation only. These settings are not consumed by the ingestion worker.
NEWS_DEDUP_MODEL_ENDPOINT=https://openrouter.ai/api/alpha/decisions
NEWS_DEDUP_MODEL_NAME=typesafe/jev-1.13
NEWS_DEDUP_MODEL_API_KEY=
NEWS_DEDUP_COMPARATOR_MODEL=openai/gpt-6-luna
# Luna production defaults. Provide credentials explicitly before running a worker.
MODEL_ROUTE=cloud_small
CLOUD_MODEL_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL_API_KEY=
CLOUD_MODEL_NAME=openai/gpt-6-luna
CLOUD_MODEL_RESPONSE_FORMAT=json_schema
CLOUD_MODEL_REASONING_EFFORT=none
CLOUD_MODEL_MAX_PROMPT_PRICE=0.10
CLOUD_MODEL_MAX_COMPLETION_PRICE=0.50
TRANSLATION_MODEL_ENABLED=true
TRANSLATION_MODEL_BASE_URL=https://openrouter.ai/api/v1
TRANSLATION_MODEL_API_KEY=
TRANSLATION_PRIMARY_MODEL_NAME=openai/gpt-6-luna
TRANSLATION_FALLBACK_MODEL_NAME=
TRANSLATION_PAID_FALLBACK_ENABLED=false
TRANSLATION_MODEL_RESPONSE_FORMAT=json_schema
TRANSLATION_MODEL_REASONING_EFFORT=none
TRANSLATION_OUTPUT_LANGUAGES=zh-Hant,en,th,ja
TRANSLATION_REQUIRE_ALL_LANGUAGES=true
# Provider routing is price-sorted and limited to these USD/million-token caps.
TRANSLATION_MAX_PROMPT_PRICE=0.10
TRANSLATION_MAX_COMPLETION_PRICE=0.50
