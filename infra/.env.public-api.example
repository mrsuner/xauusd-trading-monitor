# Registry host used by VPS Docker images.
IMAGE_REGISTRY=ghcr.io
# GHCR namespace that stores this project's service images.
IMAGE_NAMESPACE=mrsuner/xauusd-trading-monitor
# Image tag to deploy; use a git SHA for production rollback safety.
IMAGE_TAG=main

# Public PostgreSQL database name on the VPS.
PUBLIC_POSTGRES_DB=xauusd_public
# Public PostgreSQL application user on the VPS.
PUBLIC_POSTGRES_USER=xauusd_public
# Public PostgreSQL password on the VPS.
PUBLIC_POSTGRES_PASSWORD=change-me
# PostgreSQL connection URL used by public-api and public-api-migrate inside Compose.
PUBLIC_DATABASE_URL=postgresql://xauusd_public:change-me@public-postgres:5432/xauusd_public
# Max startup DB connection attempts before public-api exits and lets Docker restart it.
DB_CONNECT_MAX_ATTEMPTS=10
# Initial startup DB retry delay in seconds.
DB_CONNECT_INITIAL_BACKOFF_SECONDS=1
# Maximum startup DB retry delay in seconds.
DB_CONNECT_MAX_BACKOFF_SECONDS=30

# Auth mode for ingest requests from HomeLab public-syncer: hmac or bearer.
PUBLIC_INGEST_AUTH_MODE=hmac
# HMAC key id expected from HomeLab public-syncer.
PUBLIC_INGEST_KEY_ID=homelab-main
# HMAC secret shared only between HomeLab public-syncer and VPS public-api.
PUBLIC_INGEST_SECRET=change-me
# Optional bearer token fallback for testing when PUBLIC_INGEST_AUTH_MODE=bearer.
PUBLIC_API_TOKEN=change-me
# Max accepted ingest payload size in bytes.
PUBLIC_INGEST_MAX_BODY_BYTES=262144
# Allowed clock skew in seconds for HMAC timestamp validation.
PUBLIC_INGEST_TIMESTAMP_SKEW_SECONDS=300
# Max public summary length accepted by ingest validation.
PUBLIC_INGEST_MAX_SUMMARY_CHARS=4000
# Max public title length accepted by ingest validation.
PUBLIC_INGEST_MAX_TITLE_CHARS=300

# Browser origins allowed to read the public API.
CORS_ORIGINS=https://news.thetickbase.com,http://localhost:5173,http://localhost:5177
# Default page size for public read endpoints.
DEFAULT_PAGE_SIZE=20
# Maximum page size for public read endpoints.
MAX_PAGE_SIZE=100
# Host address bound by public-api on the VPS.
PUBLIC_API_HOST=127.0.0.1
# Host port exposed for Cloudflare Tunnel to reach public-api.
PUBLIC_API_HOST_PORT=8080

# Runtime environment name used by services.
APP_ENV=production
# Service log verbosity.
LOG_LEVEL=INFO
# Container timezone.
TZ=Asia/Bangkok
