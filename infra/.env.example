# Registry host used by production Docker images.
IMAGE_REGISTRY=ghcr.io
# GHCR namespace that stores this project's service images.
IMAGE_NAMESPACE=mrsuner/xauusd-trading-monitor
# Image tag to deploy; use a git SHA for production rollback safety.
IMAGE_TAG=main

# PostgreSQL database name.
POSTGRES_DB=xauusd_event_radar
# PostgreSQL application user.
POSTGRES_USER=xauusd
# PostgreSQL password for the application user.
POSTGRES_PASSWORD=change-me
# PostgreSQL connection URL used by all backend services inside Compose.
DATABASE_URL=postgresql://xauusd:change-me@postgres:5432/xauusd_event_radar
# Max startup DB connection attempts before the service exits and lets Docker restart it.
DB_CONNECT_MAX_ATTEMPTS=10
# Initial startup DB retry delay in seconds.
DB_CONNECT_INITIAL_BACKOFF_SECONDS=1
# Maximum startup DB retry delay in seconds.
DB_CONNECT_MAX_BACKOFF_SECONDS=30

# Telegram API ID for the Telethon user session collector.
TELEGRAM_API_ID=change-me
# Telegram API hash for the Telethon user session collector.
TELEGRAM_API_HASH=change-me
# Path inside the container where the Telethon session file is stored.
TELEGRAM_SESSION_PATH=/app/sessions/xauusd-event-radar.session
# Host directory mounted to persist Telethon session files. Keep this outside infra/ so rsync deployments cannot overwrite it.
TELEGRAM_SESSION_HOST_DIR=/home/luke/xauusd-trading-monitor-data/telegram-sessions

# Telegram Bot token for private alert notifications.
TELEGRAM_BOT_TOKEN=change-me
# Telegram chat ID that receives private alert notifications.
TELEGRAM_CHAT_ID=change-me

# Pushover application token for private high-priority alerts.
PUSHOVER_APP_TOKEN=change-me
# Pushover user or group key for private high-priority alerts.
PUSHOVER_USER_KEY=change-me
# Retry interval in seconds for Pushover emergency priority messages.
PUSHOVER_EMERGENCY_RETRY_SECONDS=60
# Expiration window in seconds for Pushover emergency retries.
PUSHOVER_EMERGENCY_EXPIRE_SECONDS=600
# Enable or disable private Telegram alert delivery.
ENABLE_TELEGRAM_ALERTS=true
# Enable or disable private Pushover alert delivery.
ENABLE_PUSHOVER_ALERTS=true
# Deprecated: alert-dispatcher no longer creates alert decisions; keep false.
ENABLE_POLLING_FALLBACK=false
# Record alert decisions without sending provider requests when true.
ALERT_DRY_RUN=false
# Deprecated: event-router now owns backfill route behavior.
ALERT_BACKFILL_MODE=telegram_only
# Deprecated: alert-dispatcher no longer scans existing events.
DISPATCH_EXISTING_EVENTS_ON_START=true
# Poll interval in seconds for alert-dispatcher.
POLL_INTERVAL_SECONDS=2
# Event lookback window in minutes for alert polling fallback.
EVENT_LOOKBACK_MINUTES=120
# Number of recent events scanned per alert polling cycle.
EVENT_BATCH_SIZE=50
# Number of pending alerts claimed per delivery cycle.
ALERT_BATCH_SIZE=10
# Stop alert-dispatcher after this many alerts; 0 means unlimited.
MAX_ALERTS_PER_RUN=0
# Max provider delivery attempts before marking an alert failed.
MAX_ATTEMPTS=3
# Initial retry backoff in seconds for alert provider failures.
INITIAL_BACKOFF_SECONDS=10
# Maximum retry backoff in seconds for alert provider failures.
MAX_BACKOFF_SECONDS=300
# HTTP timeout in seconds for Telegram Bot and Pushover alert providers.
ALERT_PROVIDER_TIMEOUT_SECONDS=10

# Enable routing normalized events to private Telegram alerts.
ENABLE_PRIVATE_TELEGRAM_ROUTE=true
# Enable routing normalized events to private Pushover alerts.
ENABLE_PRIVATE_PUSHOVER_ROUTE=true
# Enable routing normalized events to the public Telegram Channel outbox.
ENABLE_PUBLIC_TELEGRAM_CHANNEL_ROUTE=true
# Enable routing normalized events to the future public website outbox.
ENABLE_PUBLIC_WEBSITE_ROUTE=false
# Enable routing normalized events to the future X publisher outbox.
ENABLE_PUBLIC_X_ROUTE=false
# Whether event-router should process older events on startup.
EVENT_ROUTER_DISPATCH_EXISTING_EVENTS_ON_START=false
# How event-router handles older startup events: skip, telegram_only, or normal.
EVENT_ROUTER_BACKFILL_MODE=telegram_only
# Poll interval in seconds for event-router.
EVENT_ROUTER_POLL_INTERVAL_SECONDS=2
# Event lookback window in minutes when startup backfill is enabled.
EVENT_ROUTER_LOOKBACK_MINUTES=120
# Number of unrouted events processed per event-router cycle.
EVENT_ROUTER_BATCH_SIZE=50
# Stop event-router after this many events; 0 means unlimited.
EVENT_ROUTER_MAX_EVENTS_PER_RUN=0
# Minimum route score for private Telegram alerts.
PRIVATE_TELEGRAM_ROUTE_SCORE_THRESHOLD=45
# Minimum route score for S severity private Telegram alerts.
PRIVATE_TELEGRAM_S_ROUTE_SCORE_THRESHOLD=35
# Minimum route score for private Pushover alerts.
PRIVATE_PUSHOVER_ROUTE_SCORE_THRESHOLD=85
# Minimum route score for public Telegram Channel outbox entries.
PUBLIC_TELEGRAM_ROUTE_SCORE_THRESHOLD=65
# Minimum route score for future public website outbox entries.
PUBLIC_WEBSITE_ROUTE_SCORE_THRESHOLD=50
# Minimum route score for future X publisher outbox entries.
PUBLIC_X_ROUTE_SCORE_THRESHOLD=85
# Minimum relevance score required for A severity events to enter the X outbox. S severity events always pass this severity policy.
PUBLIC_X_A_RELEVANCE_THRESHOLD=85

# Enable the public Telegram Channel publisher service.
TELEGRAM_CHANNEL_PUBLISHER_ENABLED=false
# Record public Channel publish decisions without sending Telegram requests.
TELEGRAM_CHANNEL_DRY_RUN=true
# Telegram Bot token used to publish to the public Channel.
TELEGRAM_CHANNEL_BOT_TOKEN=change-me
# Public Telegram Channel ID or @username.
TELEGRAM_CHANNEL_ID=change-me
# Telegram parse mode for public Channel messages: HTML or plain.
TELEGRAM_CHANNEL_PARSE_MODE=HTML
# Disable Telegram link previews for public Channel messages.
TELEGRAM_CHANNEL_DISABLE_WEB_PAGE_PREVIEW=false
# Minimum severity allowed for public Channel publishing.
TELEGRAM_CHANNEL_MIN_SEVERITY=A
# Whether B severity public events may be published to the Channel.
TELEGRAM_CHANNEL_INCLUDE_B_EVENTS=false
# Maximum public Channel messages sent per hour; 0 disables this limit.
TELEGRAM_CHANNEL_MAX_PER_HOUR=30
# Max Telegram Channel provider attempts before marking publish failed.
TELEGRAM_CHANNEL_MAX_ATTEMPTS=5
# Retry backoff in seconds for public Channel publish failures.
TELEGRAM_CHANNEL_RETRY_BACKOFF_SECONDS=60
# Number of public outbox rows claimed per publisher cycle.
TELEGRAM_CHANNEL_BATCH_SIZE=5
# HTTP timeout in seconds for the public Channel Telegram API request.
TELEGRAM_CHANNEL_PROVIDER_TIMEOUT_SECONDS=10
# Seconds before a stuck public Channel lock can be reclaimed.
TELEGRAM_CHANNEL_LOCK_TIMEOUT_SECONDS=300
# Maximum Telegram Channel message length after formatting.
TELEGRAM_CHANNEL_MESSAGE_LIMIT_CHARS=3900
# Poll interval in seconds for public publisher workers.
PUBLISHER_POLL_INTERVAL_SECONDS=10

# Enable the public X publisher service.
X_PUBLISHER_ENABLED=false
# Record X publish decisions without sending provider requests.
X_PUBLISHER_DRY_RUN=true
# X API v2 base URL used for posting.
X_API_BASE_URL=https://api.twitter.com/2
# X app API key for OAuth 1.0a user-context posting.
X_API_KEY=change-me
# X app API secret for OAuth 1.0a user-context posting.
X_API_SECRET=change-me
# X account access token with write permission.
X_ACCESS_TOKEN=change-me
# X account access token secret with write permission.
X_ACCESS_TOKEN_SECRET=change-me
# Optional X bearer token; V1 posting uses OAuth 1.0a, not app-only bearer auth.
X_BEARER_TOKEN=change-me
# Conservative max post length; leaves buffer below the platform limit.
X_POST_MAX_CHARS=260
# Minimum severity allowed for X publishing.
X_PUBLISHER_MIN_SEVERITY=A
# Whether B severity public events may be published to X.
X_PUBLISHER_INCLUDE_B_EVENTS=false
# Maximum X posts sent per hour; 0 disables this limit.
X_PUBLISHER_MAX_PER_HOUR=10
# Maximum X posts sent per 24 hours; 0 disables this limit.
X_PUBLISHER_MAX_PER_DAY=50
# Max X provider attempts before marking publish failed.
X_PUBLISHER_MAX_ATTEMPTS=4
# Retry backoff in seconds for X publish failures.
X_PUBLISHER_RETRY_BACKOFF_SECONDS=300
# Number of public outbox rows claimed per X publisher cycle.
X_PUBLISHER_BATCH_SIZE=1
# HTTP timeout in seconds for the X API request.
X_PUBLISHER_PROVIDER_TIMEOUT_SECONDS=10
# Seconds before a stuck X publish lock can be reclaimed.
X_PUBLISHER_LOCK_TIMEOUT_SECONDS=300
# Require at least one public source link before posting to X.
X_PUBLISHER_REQUIRE_SOURCE_LINK=true
# Optional lower bound for X publishing; set to an ISO timestamp to prevent historical backfill posts.
X_PUBLISHER_MIN_GENERATED_AT=
# Enable AI semantic duplicate detection before posting to X. Blank model settings fall back to TRANSLATION_* / OPENROUTER_*.
X_SEMANTIC_DEDUPE_ENABLED=false
# Look back this many minutes for already sent X posts to compare against.
X_SEMANTIC_DEDUPE_WINDOW_MINUTES=30
# Maximum recent X posts sent to the model per candidate check.
X_SEMANTIC_DEDUPE_CANDIDATE_LIMIT=8
# Minimum model similarity score required to skip as a semantic duplicate.
X_SEMANTIC_DEDUPE_THRESHOLD=85
# Optional OpenAI-compatible model override for X semantic dedupe.
X_SEMANTIC_DEDUPE_MODEL_BASE_URL=
# Optional API key override for X semantic dedupe.
X_SEMANTIC_DEDUPE_MODEL_API_KEY=
# Optional model name override for X semantic dedupe.
X_SEMANTIC_DEDUPE_MODEL_NAME=
# Optional paid fallback model override for X semantic dedupe.
X_SEMANTIC_DEDUPE_FALLBACK_MODEL_NAME=
# Enable paid fallback after the primary semantic dedupe model fails.
X_SEMANTIC_DEDUPE_PAID_FALLBACK_ENABLED=true
# Response format for the semantic dedupe model: none, json_object, json_schema, or text.
X_SEMANTIC_DEDUPE_RESPONSE_FORMAT=json_object
# Optional reasoning effort forwarded to compatible providers.
X_SEMANTIC_DEDUPE_REASONING_EFFORT=
# Optional HTTP-Referer header for OpenRouter-style providers.
X_SEMANTIC_DEDUPE_HTTP_REFERER=
# Optional X-Title header for OpenRouter-style providers.
X_SEMANTIC_DEDUPE_APP_TITLE="XAUUSD Event Radar"

# Enable HomeLab to VPS public website syncer.
PUBLIC_SYNCER_ENABLED=false
# Record public website sync payloads without sending HTTPS requests.
PUBLIC_SYNCER_DRY_RUN=true
# VPS public-api base URL, for example https://news-api.example.com or Cloudflare Tunnel URL.
PUBLIC_API_BASE_URL=
# public-api ingest path.
PUBLIC_INGEST_PATH=/ingest/events
# Auth mode used by public-syncer: hmac or bearer.
PUBLIC_SYNC_AUTH_MODE=hmac
# HMAC key id shared with VPS public-api.
PUBLIC_SYNC_KEY_ID=homelab-main
# HMAC secret shared with VPS public-api.
PUBLIC_SYNC_SECRET=change-me
# Optional bearer token when PUBLIC_SYNC_AUTH_MODE=bearer.
PUBLIC_SYNC_API_KEY=change-me
# Number of public outbox rows claimed per public-syncer cycle.
PUBLIC_SYNCER_BATCH_SIZE=10
# Max public-api sync attempts before marking failed.
PUBLIC_SYNCER_MAX_ATTEMPTS=5
# Retry backoff in seconds for public-api transient failures.
PUBLIC_SYNCER_RETRY_BACKOFF_SECONDS=60
# Maximum successful syncs per minute; 0 disables this limit.
PUBLIC_SYNCER_MAX_PER_MINUTE=60
# HTTP timeout in seconds for public-api requests.
PUBLIC_SYNCER_PROVIDER_TIMEOUT_SECONDS=10
# Seconds before a stuck public website sync lock can be reclaimed.
PUBLIC_SYNCER_LOCK_TIMEOUT_SECONDS=300
# Poll interval in seconds for public-syncer.
PUBLIC_SYNCER_POLL_INTERVAL_SECONDS=10

# Main model route for Layer 2 classification.
MODEL_ROUTE=cloud_small
# OpenAI-compatible base URL for local model routing.
LOCAL_MODEL_BASE_URL=http://192.168.1.50:11434/v1
# API key for the local model route; may be blank for local servers.
LOCAL_MODEL_API_KEY=
# Model name used by the local model route.
LOCAL_MODEL_NAME=change-me
# Response format hint for the local model route.
LOCAL_MODEL_RESPONSE_FORMAT=none
# Reasoning effort hint for the local model route, if supported.
LOCAL_MODEL_REASONING_EFFORT=
# OpenAI-compatible base URL for the cloud classification model.
CLOUD_MODEL_BASE_URL=https://api.openai.com/v1
# API key for the cloud classification model.
CLOUD_MODEL_API_KEY=change-me
# Model name for core classification and relevance judgment.
CLOUD_MODEL_NAME=gpt-5.4-mini
# Response format hint for the cloud classification model.
CLOUD_MODEL_RESPONSE_FORMAT=json_object
# Reasoning effort hint for the cloud classification model, if supported.
CLOUD_MODEL_REASONING_EFFORT=
# Enable an auxiliary model route for future low-risk tasks.
AUXILIARY_MODEL_ENABLED=false
# Auxiliary model route name; use disabled until configured.
AUXILIARY_MODEL_ROUTE=disabled
# OpenRouter OpenAI-compatible base URL.
OPENROUTER_MODEL_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter API key for optional auxiliary or translation models.
OPENROUTER_MODEL_API_KEY=change-me
# Default OpenRouter model name for auxiliary usage.
OPENROUTER_MODEL_NAME=change-me
# Response format hint for OpenRouter auxiliary usage.
OPENROUTER_MODEL_RESPONSE_FORMAT=json_object
# Reasoning effort hint for OpenRouter models, if supported.
OPENROUTER_MODEL_REASONING_EFFORT=
# Optional HTTP referer header sent to OpenRouter.
OPENROUTER_HTTP_REFERER=
# Optional app title header sent to OpenRouter.
OPENROUTER_APP_TITLE="XAUUSD Event Radar"
# Enable Layer 1 translation-summary model calls.
TRANSLATION_MODEL_ENABLED=true
# OpenAI-compatible base URL for the translation-summary route.
TRANSLATION_MODEL_BASE_URL=https://openrouter.ai/api/v1
# API key for translation route; blank falls back to OPENROUTER_MODEL_API_KEY.
TRANSLATION_MODEL_API_KEY=
# Primary low-cost/free model used for translation and summary.
TRANSLATION_PRIMARY_MODEL_NAME=openai/gpt-oss-20b:free
# Paid fallback model used when the primary translation model fails.
TRANSLATION_FALLBACK_MODEL_NAME=openai/gpt-oss-20b
# Allow paid fallback for translation-summary calls.
TRANSLATION_PAID_FALLBACK_ENABLED=true
# Response format hint for translation-summary calls.
TRANSLATION_MODEL_RESPONSE_FORMAT=none
# Reasoning effort hint for translation models, if supported.
TRANSLATION_MODEL_REASONING_EFFORT=
# Optional HTTP referer header for translation provider requests.
TRANSLATION_HTTP_REFERER=
# Optional app title header for translation provider requests.
TRANSLATION_APP_TITLE="XAUUSD Event Radar"
# Default max input characters sent to the translation layer.
TRANSLATION_DEFAULT_MAX_CHARS=20000
# Max input characters for high-priority sources in translation layer.
TRANSLATION_HIGH_PRIORITY_MAX_CHARS=100000
# Absolute max input characters for one translation call.
TRANSLATION_SINGLE_CALL_MAX_CHARS=100000
# Max classification calls per normalizer run; 0 means unlimited.
MAX_CLASSIFICATION_CALLS_PER_RUN=0
# Max translation calls per normalizer run; 0 means unlimited.
MAX_TRANSLATION_CALLS_PER_RUN=0
# Max paid translation fallback calls per normalizer run; 0 means unlimited.
MAX_TRANSLATION_PAID_FALLBACK_CALLS_PER_RUN=0
# HTTP timeout in seconds for AI model requests.
MODEL_TIMEOUT_SECONDS=30
# Legacy/global max model call guard; 0 means unlimited.
MAX_MODEL_CALLS_PER_RUN=0
# Number of normalizer-classifier containers to run in production.
NORMALIZER_REPLICAS=2
# Worker loops per normalizer-classifier container.
NORMALIZER_WORKER_CONCURRENCY=2
# Minimum PostgreSQL connections kept by each normalizer-classifier container.
NORMALIZER_DB_POOL_MIN_SIZE=1
# Maximum PostgreSQL connections per normalizer-classifier container; 0 auto-sizes from worker concurrency.
NORMALIZER_DB_POOL_MAX_SIZE=0
# Seconds before a stuck normalizer task can be recovered.
NORMALIZER_STALE_TASK_TIMEOUT_SECONDS=900

# Enable Claude Code Agent SDK model route.
CLAUDE_CODE_AGENT_ENABLED=false
# Claude Code Agent SDK model name.
CLAUDE_CODE_AGENT_MODEL=change-me

# Token required by dashboard-api for protected endpoints.
API_TOKEN=change-me
# Allowed browser origins for dashboard-api CORS.
CORS_ORIGINS=http://localhost:5173
# Host address bound by dashboard-api on the HomeLab machine.
DASHBOARD_API_HOST=127.0.0.1
# Host port exposed for dashboard-api.
DASHBOARD_API_HOST_PORT=8080

# API base URL used by dashboard-web; /api is proxied by nginx in production.
DASHBOARD_API_BASE_URL=/api
# API token used by dashboard-web when calling dashboard-api.
DASHBOARD_API_TOKEN=change-me
# Host address bound by dashboard-web on the HomeLab machine.
DASHBOARD_WEB_HOST=0.0.0.0
# Host port exposed for dashboard-web.
DASHBOARD_WEB_HOST_PORT=5173

# Runtime environment name used by services.
APP_ENV=production
# Service log verbosity.
LOG_LEVEL=INFO
# Optional normalizer-classifier override for short-lived AI request/response sample collection.
NORMALIZER_LOG_LEVEL=INFO
# Docker json-file log rotation size per retained file.
DOCKER_LOG_MAX_SIZE=100m
# Docker json-file retained file count per container. 100m x 45 targets 30+ days under normal log volume.
DOCKER_LOG_MAX_FILE=45
# Container timezone.
TZ=Asia/Bangkok
